NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admission fee payments (mobile money). Keys come from the payment gateway dashboard, Developers section.
PAYMENTS_BRAND_ID=your-brand-id
PAYMENTS_SECRET_KEY=your-secret-key
# Optional: gateway API address, if it differs from the default.
PAYMENTS_API_URL=
# Optional: public address of this site, used for payment confirmations (defaults to https://kja.ug).
PAYMENTS_CALLBACK_BASE_URL=

# Email alerts: every admin on Admin -> Team is emailed about new admission and job applications.
# Connect Resend (https://resend.com, verify your domain first) or any SMTP server. Resend is used if both are set.
EMAIL_FROM="Kampala Junior Academy <admissions@kja.ug>"
RESEND_API_KEY=
# SMTP example for Google Workspace: smtp.gmail.com, port 587, the mailbox address and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: public address of this site, used for links and the logo in emails (defaults to https://kja.ug).
NEXT_PUBLIC_SITE_URL=
