NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paytota mobile money (https://gate.paytota.com). Keys from Developers → API keys.
PAYMENTS_BRAND_ID=your-brand-id
PAYMENTS_SECRET_KEY=your-secret-key
# Optional: gateway API address (defaults to https://gate.paytota.com).
PAYMENTS_API_URL=
# Public Next.js origin for Paytota webhooks + success_callback.
# On Vercel this can be left blank (uses VERCEL_URL). Otherwise set to e.g. https://kja-phi.vercel.app
# Also register the same URL + /api/payments/callback in Paytota → Developers → Webhooks
# (listen for purchase.paid and purchase.payment_failure).
PAYMENTS_CALLBACK_BASE_URL=https://kja-phi.vercel.app

# Email alerts: every admin on Admin -> Team is emailed about new admission and job applications.
# Connect Resend (https://resend.com, verify your domain first) or any SMTP server. Resend is used if both are set.
EMAIL_FROM="Kampala Junior Academy <admissions@kja.ug>"
RESEND_API_KEY=
# SMTP example for Google Workspace: smtp.gmail.com, port 587, the mailbox address and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Public Next.js site URL (links in emails, SEO). Prefer the Vercel app while WordPress still owns kja.ug.
NEXT_PUBLIC_SITE_URL=https://kja-phi.vercel.app
