# Optional: real Supabase project URL for the loopback proxy.
# If omitted, Desktop App reads NEXT_PUBLIC_SUPABASE_URL from the website
# ../.env or ../.env.local (as long as it is not already the proxy URL).
KJA_UPSTREAM_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Usually inherited from the website env:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# KJA_SITE_URL=https://kja.ug
